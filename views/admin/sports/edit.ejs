<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <header class="navbar">
      <h1>Sports Scheduler</h1>
      <a href="/admin/sports" class="btn btn-secondary">Back to Sports</a>
    </header>

    <main>
      <h2>Edit Sport: <%= sport.name %></h2>

      <% if (messages && messages.error && messages.error.length > 0) { %>
        <div class="alert alert-error">
          <% messages.error.forEach(function(msg) { %>
            <p><%= msg %></p>
          <% }); %>
        </div>
      <% } %>

      <form action="/admin/sports/<%= sport.id %>" method="POST" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label for="name">Sport Name *</label>
          <input type="text" id="name" name="name" value="<%= sport.name %>" required>
        </div>

        <div class="form-group">
          <label for="description">Description (Optional)</label>
          <textarea id="description" name="description" rows="4"><%= sport.description || '' %></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Update Sport</button>
      </form>
    </main>
  </div>
</body>
</html>
