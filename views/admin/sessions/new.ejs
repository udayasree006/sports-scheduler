<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <header class="navbar">
      <h1>Sports Scheduler</h1>
      <a href="/admin/sessions" class="btn btn-secondary">Back to Sessions</a>
    </header>

    <main>
      <h2>Create New Sports Session</h2>

      <% if (messages && messages.error && messages.error.length > 0) { %>
        <div class="alert alert-error">
          <% messages.error.forEach(function(msg) { %>
            <p><%= msg %></p>
          <% }); %>
        </div>
      <% } %>

      <% if (sports.length === 0) { %>
        <div class="alert alert-error">
          <p>No active sports available. Please <a href="/admin/sports/new">create an active sport</a> first.</p>
        </div>
      <% } else { %>
        <form action="/admin/sessions" method="POST" class="auth-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="form-group">
            <label for="sportId">Select Sport *</label>
            <select id="sportId" name="sportId" required class="form-control">
              <option value="">-- Choose a Sport --</option>
              <% sports.forEach(function(sport) { %>
                <option value="<%= sport.id %>"><%= sport.name %></option>
              <% }); %>
            </select>
          </div>

          <div class="form-group">
            <label for="date">Date *</label>
            <input type="date" id="date" name="date" required>
          </div>

          <div class="form-group">
            <label for="time">Time *</label>
            <input type="time" id="time" name="time" required>
          </div>

          <div class="form-group">
            <label for="venue">Venue *</label>
            <input type="text" id="venue" name="venue" required placeholder="e.g. Central Park Court 1">
          </div>

          <div class="form-group">
            <label for="additionalPlayersNeeded">Additional Players Needed *</label>
            <input type="number" id="additionalPlayersNeeded" name="additionalPlayersNeeded" min="0" value="4" required>
          </div>

          <button type="submit" class="btn btn-primary">Create Session</button>
        </form>
      <% } %>
    </main>
  </div>
</body>
</html>
