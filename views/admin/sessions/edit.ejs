<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <header class="navbar">
      <h1>Sports Scheduler</h1>
      <a href="/admin/sessions" class="btn btn-secondary">Back to Sessions</a>
    </header>

    <main>
      <h2>Edit Session #<%= sessionItem.id %></h2>

      <% if (messages && messages.error && messages.error.length > 0) { %>
        <div class="alert alert-error">
          <% messages.error.forEach(function(msg) { %>
            <p><%= msg %></p>
          <% }); %>
        </div>
      <% } %>

      <form action="/admin/sessions/<%= sessionItem.id %>" method="POST" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label for="sportId">Select Sport *</label>
          <select id="sportId" name="sportId" required class="form-control">
            <% sports.forEach(function(sport) { %>
              <option value="<%= sport.id %>" <%= sport.id === sessionItem.sportId ? 'selected' : '' %>>
                <%= sport.name %>
              </option>
            <% }); %>
          </select>
        </div>

        <div class="form-group">
          <label for="date">Date *</label>
          <input type="date" id="date" name="date" value="<%= sessionItem.date %>" required>
        </div>

        <div class="form-group">
          <label for="time">Time *</label>
          <input type="time" id="time" name="time" value="<%= sessionItem.time %>" required>
        </div>

        <div class="form-group">
          <label for="venue">Venue *</label>
          <input type="text" id="venue" name="venue" value="<%= sessionItem.venue %>" required>
        </div>

        <div class="form-group">
          <label for="additionalPlayersNeeded">Additional Players Needed *</label>
          <input type="number" id="additionalPlayersNeeded" name="additionalPlayersNeeded" min="0" value="<%= sessionItem.additionalPlayersNeeded %>" required>
        </div>

        <button type="submit" class="btn btn-primary">Update Session</button>
      </form>
    </main>
  </div>
</body>
</html>
