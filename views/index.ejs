<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <header class="navbar">
      <h1>Sports Scheduler</h1>
      <% if (locals.user) { %>
        <div class="nav-links">
          <a href="/notifications" class="btn btn-secondary">
            🔔 Notifications <%= typeof unreadNotificationsCount !== 'undefined' && unreadNotificationsCount > 0 ? '(' + unreadNotificationsCount + ')' : '' %>
          </a>
          <a href="/change-password" class="btn btn-secondary">🔑 Change Password</a>
          <form action="/logout" method="POST" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-secondary">Logout</button>
          </form>
        </div>
      <% } %>
    </header>

    <main>
      <% if (messages && messages.error && messages.error.length > 0) { %>
        <div class="alert alert-error">
          <% messages.error.forEach(function(msg) { %>
            <p><%= msg %></p>
          <% }); %>
        </div>
      <% } %>

      <% if (messages && messages.success && messages.success.length > 0) { %>
        <div class="alert alert-success">
          <% messages.success.forEach(function(msg) { %>
            <p><%= msg %></p>
          <% }); %>
        </div>
      <% } %>

      <% if (locals.user) { %>
        <div class="welcome-card">
          <h2>Welcome, <%= user.first_name %>!</h2>
          <p>You are logged in as a <strong><%= user.role === 'admin' ? 'Administrator' : 'Player' %></strong>.</p>
          
          <% if (user.role === 'admin') { %>
            <div style="margin-top: 15px;">
              <span class="badge badge-admin">Admin Dashboard</span>
            </div>
            <div class="admin-actions" style="margin-top: 20px; display: flex; gap: 12px; flex-wrap: wrap;">
              <a href="/admin/sports" class="btn btn-primary">Manage Sports</a>
              <a href="/admin/sessions" class="btn btn-primary">Manage Sessions</a>
              <a href="/admin/reports" class="btn btn-primary">Reports</a>
              <a href="/notifications" class="btn btn-secondary">🔔 Notifications <%= unreadNotificationsCount > 0 ? '(' + unreadNotificationsCount + ')' : '' %></a>
              <a href="/sessions" class="btn btn-secondary">Browse Sessions</a>
            </div>
          <% } else { %>
            <div style="margin-top: 15px;">
              <span class="badge badge-player">Player Dashboard</span>
            </div>
            <div class="player-actions" style="margin-top: 20px; display: flex; gap: 12px; flex-wrap: wrap;">
              <a href="/sessions" class="btn btn-primary">Browse Sessions</a>
              <a href="/sessions/new" class="btn btn-primary">Create Session</a>
              <a href="/my-sessions" class="btn btn-secondary">My Sessions</a>
              <a href="/my-joined-sessions" class="btn btn-secondary">My Joined Sessions</a>
              <a href="/notifications" class="btn btn-secondary">🔔 Notifications <%= unreadNotificationsCount > 0 ? '(' + unreadNotificationsCount + ')' : '' %></a>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <div class="welcome-card" style="border-left: 5px solid var(--primary); padding: 35px 25px; text-align: center;">
          <h2 style="font-size: 2.2rem; color: var(--navy-dark); margin-bottom: 10px;">Welcome to Sports Scheduler</h2>
          <p style="font-size: 1.1rem; max-width: 600px; margin: 0 auto 25px auto;">
            Please log in or sign up to manage and join sports sessions.
          </p>
          <div class="actions" style="justify-content: center; gap: 15px;">
            <a href="/login" class="btn btn-primary" style="padding: 12px 28px; font-size: 1.05rem;">Log In</a>
            <a href="/signup" class="btn btn-secondary" style="padding: 12px 28px; font-size: 1.05rem;">Sign Up</a>
          </div>
        </div>
      <% } %>
    </main>
  </div>
</body>
</html>
